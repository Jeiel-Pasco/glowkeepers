Spells.MAX_LEVEL = 5
Spells.LEVEL_BONUS = 0.1 -- +10% damage and -4% cooldown per level above 1
Spells.LEVEL_COOLDOWN = 0.04

-- Universal Ink costs to unlock fixed pages 2, 3, 4 (X, C, V) and upgrade levels 1 → 5.
