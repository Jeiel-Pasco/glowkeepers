--!strict
-- Every Grimoire's 4 fixed signature skills (Z, X, C, V) across all 11 Black Clover Grimoires,
-- plus legacy spell lookups. Pure data plus helpers.
--
-- Fixed page slots on every Grimoire (Spells.FOR_TYPE[type] = { Z, X, C, V }):
--   Page 1 (Z)  Core projectile / strike (unlocked at Lv 1 when you get the Grimoire)
--   Page 2 (X)  Mobility dash/blink or defensive shield (unlocked with Universal Ink)
--   Page 3 (C)  Crowd control / buff / combo setup (unlocked with Universal Ink)
--   Page 4 (V)  Telegraphed Ultimate Finisher (unlocked with Universal Ink)

local Spells = {}

export type Burn = { dps: number, duration: number, type: string? }
export type Push = { speed: number, lift: number, duration: number } -- +speed = knockback, -speed = pull
export type Spell = {
	id: string,
	name: string,
	type: string,
	rarity: string,
	role: string,
	kind: string,
	cooldown: number,
	damage: number?,
	speed: number?,
	range: number?,
	radius: number?,
	width: number?,
	delay: number?,
	amount: number?,
	duration: number?,
	distance: number?,
	power: number?,
	burn: Burn?,
	slow: { amount: number, duration: number }?, -- 1 = Hard Root / Freeze / Paralyze
	push: Push?,
	weaken: { mult: number, duration: number }?,
	cleanse: boolean?,
	speedBoost: { mult: number, duration: number }?,
	backstab: boolean?,
	slot: number?, -- 1 = Z, 2 = X, 3 = C, 4 = V
	blurb: string,
}

Spells.RARITIES = { "Common", "Rare", "Epic", "Legendary", "Mythic" }
